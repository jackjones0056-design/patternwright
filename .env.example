# Copy to .env and fill before production deploy. Never commit .env.

NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PATTERNWRIGHT_DB=./data/patternwright.db

# Required for session login (preferred)
PATTERNWRIGHT_ADMIN_USER=admin
# Prefer HASH in production; plaintext password is hashed in-memory at boot only.
PATTERNWRIGHT_ADMIN_PASSWORD=change-me-to-a-long-random-password
# Preferred in production (omit ADMIN_PASSWORD when set):
# PATTERNWRIGHT_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt_b64>$<hash_b64>

# Required in production when password auth is enabled (log fingerprint only; does not sign/invalidate cookies)
PATTERNWRIGHT_SESSION_SECRET=replace-with-long-random-string

# Optional automation fallback (header: x-patternwright-key)
# PATTERNWRIGHT_ADMIN_KEY=

# Behind HTTPS reverse proxy (Caddy/nginx/Traefik)
PATTERNWRIGHT_TRUST_PROXY=true
PATTERNWRIGHT_SECURE_COOKIES=true

# Optional session lifetime (ms). Default 12 hours.
# PATTERNWRIGHT_SESSION_TTL_MS=43200000
